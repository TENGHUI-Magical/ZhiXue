{
  "name": "zhixue-web",
  "version": "0.1.0",
  "private": true,
  "description": "智学领航前端（学生端+教师端合一，规划书 2.1 节）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && node perf/bench/bundle-budget.mjs",
    "perf:bundle": "node perf/bench/bundle-budget.mjs",
    "e2e": "node e2e/verify.mjs",
    "preview": "vite preview",
    "gen:types": "openapi-typescript ../docs/openapi.yaml -o src/api/types.ts",
    "e2e:real": "node e2e/real/api-smoke.mjs",
    "e2e:real:ui": "node e2e/real/ui-real.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.62.0",
    "axios": "^1.7.2",
    "element-plus": "^2.7.5",
    "vue": "^3.4.27",
    "vue-router": "^4.3.2"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "axe-core": "^4.14.0",
    "openapi-typescript": "^7.13.0",
    "playwright-core": "^1.64.1",
    "typescript": "~5.4.5",
    "unplugin-auto-import": "^0.18.6",
    "unplugin-vue-components": "^0.27.5",
    "vite": "^5.2.11",
    "vue-tsc": "^2.0.19"
  }
}
