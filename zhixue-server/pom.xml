<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 智学领航 · zhixue-server：模块化单体（规划书 2.1 节 阶段 A） -->
    <!-- 2026-10-24 验证通过：Spring Boot 4.0.6 + Java 21 + MyBatis-Plus 3.5.17(boot4)
         + Sa-Token 1.46.0(boot4) + springdoc 3.1.1；详见 docs/adr/ADR-004-SpringBoot版本选型.md -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>com.zhixue</groupId>
    <artifactId>zhixue-server</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>zhixue-server</name>
    <description>智学领航业务服务（模块化单体，多模块 Maven）</description>

    <modules>
        <module>zhixue-common</module>
        <module>zhixue-user</module>
        <module>zhixue-course</module>
        <module>zhixue-diagnosis</module>
        <module>zhixue-plan</module>
        <module>zhixue-notification</module>
        <module>zhixue-bootstrap</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <sa-token.version>1.46.0</sa-token.version>
        <!-- 与 springdoc 3.1.1 兼容的最低版本：2.2.30 缺 $dynamicRef，会 500 -->
        <swagger-annotations.version>2.2.55</swagger-annotations.version>
        <!-- 覆盖率只出报告、不设阈值：先看真实数据，避免为了过门禁而写无效测试 -->
        <jacoco.version>0.8.13</jacoco.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 内部模块统一版本 -->
            <dependency>
                <groupId>com.zhixue</groupId>
                <artifactId>zhixue-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- MyBatis-Plus（Spring Boot 4 专用 starter） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- Sa-Token（规划书硬约束：不使用 Spring Security） -->
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-spring-boot4-starter</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <!-- 契约字段注解：@Schema(allowableValues) 让生成的枚举与 openapi 冻结契约一致 -->
            <dependency>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-annotations</artifactId>
                <version>${swagger-annotations.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- JaCoCo：prepare-agent + report（绑定 verify），不配置 check，不设覆盖率阈值。
                 报告位置：各模块 target/site/jacoco/index.html 与 target/site/jacoco/jacoco.csv。 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <!-- 放系统临时目录：避免中文/全角冒号项目路径被 cmd.exe 转码后 agent 启动失败 -->
                            <destFile>${java.io.tmpdir}/zhixue-jacoco/${project.artifactId}.exec</destFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <dataFile>${java.io.tmpdir}/zhixue-jacoco/${project.artifactId}.exec</dataFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- surefire 默认不读取 prepare-agent 写入的 argLine 属性；显式用 @{argLine} 延迟替换 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine}</argLine>
                </configuration>
            </plugin>
            <!-- 本机机器级 JAVA_HOME 可能是 JDK 17；在 validate 阶段直接报错，
                 避免在 test 阶段才出现难以理解的 class file version 65/61。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>enforce-jdk-21</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,22)</version>
                                    <message>JDK 21 is required (project targets Java 21). Set JAVA_HOME=D:\jdk-21.0.13.0.3, or run ..\scripts\mvn21.ps1 from zhixue-server. Current java.home: ${java.home}</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>