<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 智学领航 · zhixue-server：模块化单体（规划书 2.1 节 阶段 A） -->
    <!-- 2026-10-24 验证通过：Spring Boot 4.0.6 + Java 21 + MyBatis-Plus 3.5.17(boot4)
         + Sa-Token 1.46.0(boot4) + springdoc 3.1.1；详见 docs/adr/ADR-004-SpringBoot版本选型.md -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>com.zhixue</groupId>
    <artifactId>zhixue-server</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>zhixue-server</name>
    <description>智学领航业务服务（模块化单体，多模块 Maven）</description>

    <modules>
        <module>zhixue-common</module>
        <module>zhixue-user</module>
        <module>zhixue-course</module>
        <module>zhixue-diagnosis</module>
        <module>zhixue-plan</module>
        <module>zhixue-notification</module>
        <module>zhixue-bootstrap</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <sa-token.version>1.46.0</sa-token.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 内部模块统一版本 -->
            <dependency>
                <groupId>com.zhixue</groupId>
                <artifactId>zhixue-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- MyBatis-Plus（Spring Boot 4 专用 starter） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- Sa-Token（规划书硬约束：不使用 Spring Security） -->
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-spring-boot4-starter</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>