<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.zhixue</groupId>
        <artifactId>zhixue-server</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>zhixue-bootstrap</artifactId>
    <name>zhixue-bootstrap</name>
    <description>启动模块：唯一的 Spring Boot 入口，聚合 5 个业务模块（模块化单体标准做法）</description>

    <dependencies>
        <dependency>
            <groupId>com.zhixue</groupId>
            <artifactId>zhixue-user</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.zhixue</groupId>
            <artifactId>zhixue-course</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.zhixue</groupId>
            <artifactId>zhixue-diagnosis</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.zhixue</groupId>
            <artifactId>zhixue-plan</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.zhixue</groupId>
            <artifactId>zhixue-notification</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- 接口文档：springdoc 3.1.1（Spring Boot 4 适配，替代 Knife4j） -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.1.1</version>
        </dependency>
        <!-- MySQL 驱动：版本由 spring-boot-starter-parent 管理；运行期才需要 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>