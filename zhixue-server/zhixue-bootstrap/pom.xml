<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.zhixue</groupId>
        <artifactId>zhixue-server</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>zhixue-bootstrap</artifactId>
    <name>zhixue-bootstrap</name>
    <description>启动模块：唯一的 Spring Boot 入口，聚合 5 个业务模块（模块化单体标准做法）</description>

    <properties>
        <!-- 默认跳过 @Tag("it") 集成测试；CI 用 -Pit 且 RUN_IT=true 执行 -->
        <test.excluded.groups>it</test.excluded.groups>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>1.21.4</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>com.zhixue</groupId>
            <artifactId>zhixue-user</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.zhixue</groupId>
            <artifactId>zhixue-course</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.zhixue</groupId>
            <artifactId>zhixue-diagnosis</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.zhixue</groupId>
            <artifactId>zhixue-plan</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.zhixue</groupId>
            <artifactId>zhixue-notification</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- 接口文档：springdoc 3.1.1（Spring Boot 4 适配，替代 Knife4j） -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.1.1</version>
        </dependency>
        <!-- MySQL 驱动：版本由 spring-boot-starter-parent 管理；运行期才需要 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 集成测试：Spring 上下文 + Testcontainers MySQL/Redis + JDK HttpServer 桩 AI -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${test.excluded.groups}</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>it</id>
            <properties>
                <!-- none 不是任何测试标签，等效于不排除；CI 用 -Pit 执行集成测试 -->
                <test.excluded.groups>none</test.excluded.groups>
            </properties>
        </profile>
    </profiles>
</project>